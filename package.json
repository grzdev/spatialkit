{
  "name": "spatialkit",
  "version": "0.1.0",
  "description": "Lightweight WebXR spatial UI framework for smart glasses and AR experiences. Gesture control, floating HUDs, 3D model viewer — all in the browser.",
  "type": "module",
  "main": "./dist/spatialkit.cjs.js",
  "module": "./dist/spatialkit.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/spatialkit.es.js",
      "require": "./dist/spatialkit.cjs.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --emitDeclarationOnly && vite build",
    "dev": "vite --config demo/vite.config.ts",
    "demo": "vite --config demo/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "webxr",
    "ar",
    "augmented-reality",
    "3d",
    "spatial-ui",
    "smart-glasses",
    "three.js",
    "gesture-control",
    "mediapipe",
    "hand-tracking",
    "xr",
    "hud",
    "spatial-computing",
    "framework",
    "library"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/grzdev/spatialkit.git"
  },
  "homepage": "https://github.com/grzdev/spatialkit#readme",
  "peerDependencies": {
    "@mediapipe/tasks-vision": ">=0.10.0",
    "three": ">=0.150.0"
  },
  "peerDependenciesMeta": {
    "@mediapipe/tasks-vision": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "^0.10.14",
    "@types/three": "^0.167.0",
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "three": "^0.167.0",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.5.4"
  }
}

