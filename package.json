{
  "name": "spatialkit",
  "version": "0.1.0",
  "description": "Composable selection and annotations for React Three Fiber, with optional Three.js and WebXR utilities.",
  "type": "module",
  "main": "./dist/spatialkit.cjs",
  "module": "./dist/spatialkit.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/spatialkit.js",
      "require": "./dist/spatialkit.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./gestures": {
      "types": "./dist/gestures.d.ts",
      "import": "./dist/gestures.js",
      "require": "./dist/gestures.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite --config examples/inspector/vite.config.ts",
    "demo": "vite --config examples/inspector/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p examples/inspector/tsconfig.json",
    "prepublishOnly": "npm run build",
    "demo:legacy": "vite --config demo/vite.config.ts",
    "build:example": "npm run build && vite build --config examples/inspector/vite.config.ts",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "test:package": "npm run build && node scripts/test-package.mjs"
  },
  "keywords": [
    "webxr",
    "ar",
    "augmented-reality",
    "3d",
    "spatial-ui",
    "smart-glasses",
    "three.js",
    "gesture-control",
    "mediapipe",
    "hand-tracking",
    "xr",
    "hud",
    "spatial-computing",
    "framework",
    "library"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/grzdev/spatialkit.git"
  },
  "homepage": "https://github.com/grzdev/spatialkit#readme",
  "peerDependencies": {
    "@mediapipe/tasks-vision": ">=0.10.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": ">=0.150.0"
  },
  "peerDependenciesMeta": {
    "@mediapipe/tasks-vision": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@react-three/fiber": {
      "optional": true
    },
    "@react-three/drei": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "^0.10.14",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/test-renderer": "^8.2.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.167.0",
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.167.0",
    "tsx": "^4.23.13",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.5.4"
  },
  "sideEffects": false
}
